# deploy/.env 로 복사해서 값을 채운다. deploy/.env 는 git 에 올리지 않는다.

# PostgreSQL 비밀번호. 처음 띄울 때 볼륨에 고정되므로, 바꾸려면 DB 안에서도 바꿔야 한다.
BCML_DB_PASSWORD=

# (선택) 호스트에서 여는 포트. 기본 8080.
BCML_HTTP_PORT=

# (선택) TLS 를 가로채는 프록시 뒤에서 이미지를 빌드할 때만: 그 프록시 CA 인증서 묶음(PEM)의 절대 경로.
# deploy/ 밖의 파일이면 docker compose 를 직접 부를 때 BUILDX_BAKE_ENTITLEMENTS_FS=0 도 함께 준다.
BCML_BUILD_EXTRA_CA=
